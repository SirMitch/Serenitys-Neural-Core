## 9. Risk & Position Sizing Logic

### 9.1 Hard Safety Limits (Immutable)

These constants are defined at system level and cannot be overridden by any user configuration, slider, or API call:

```python
# ==========================================
# HARD SAFETY LIMITS — NEVER MODIFY AT RUNTIME
# ==========================================
HARD_MAX_RISK_PCT           = 0.05   # 5% of portfolio per trade
HARD_MAX_PORTFOLIO_DRAWDOWN = 0.20   # 20% portfolio drawdown triggers full halt
HARD_MAX_CONCURRENT_TRADES  = 15     # absolute maximum open positions
HARD_MIN_STOP_LOSS_ATR_MULT = 1.0    # stop must be at least 1 ATR from entry
HARD_MAX_SECTOR_CONCENTRATION = 0.40 # no sector > 40% of portfolio
HARD_MIN_LIQUIDITY_VOLUME   = 500_000  # min avg daily volume
HARD_EARNINGS_BLACKOUT_DAYS = 2      # no entries within 2 days of earnings
```

---

### 9.2 Position Sizer

```python
class PositionSizer:
    def __init__(self, broker_connector, hard_limits: dict):
        self.broker = broker_connector
        self.limits = hard_limits

    def compute(self, ticker: str,
                entry_price: float,
                stop_loss_price: float,
                conviction_score: float,
                config: dict) -> dict:
        """
        Returns position sizing dict:
        {shares, position_value, risk_amount, stop_pct, profit_target}
        """
        equity = self.broker.get_account_equity()
        risk_per_trade_pct = min(
            config["position_size_pct"],
            self.limits["HARD_MAX_RISK_PCT"]
        )
        risk_amount = equity * risk_per_trade_pct

        stop_distance = abs(entry_price - stop_loss_price)
        if stop_distance < 0.01:
            stop_distance = entry_price * 0.01  # min 1% stop

        shares = int(risk_amount / stop_distance)
        position_value = shares * entry_price

        # Kelly-scaled conviction (half-Kelly for safety)
        kelly_fraction = conviction_score - 0.5  # rough Kelly numerator
        kelly_scale = max(0.2, min(1.0, kelly_fraction * 2))  # half-Kelly
        shares = max(1, int(shares * kelly_scale))
        position_value = shares * entry_price

        # Max position check
        max_position = equity * self.limits["HARD_MAX_RISK_PCT"] * 5
        if position_value > max_position:
            shares = int(max_position / entry_price)
            position_value = shares * entry_price

        # Profit target: RR ratio from config
        rr = config["profit_target_rr"]
        if entry_price > stop_loss_price:  # LONG
            profit_target = entry_price + (stop_distance * rr)
        else:  # SHORT
            profit_target = entry_price - (stop_distance * rr)

        return {
            "shares":          shares,
            "position_value":  position_value,
            "risk_amount":     risk_amount,
            "stop_loss":       stop_loss_price,
            "profit_target":   profit_target,
            "stop_pct":        stop_distance / entry_price,
            "rr_ratio":        rr
        }
```

---

### 9.3 Portfolio-Level Risk Guard

```python
class DrawdownGuard:
    def __init__(self, broker_connector, config: dict):
        self.broker = broker_connector
        self.config = config
        self.peak_equity = None

    def update_and_check(self) -> tuple[bool, str]:
        """
        Returns (trading_allowed: bool, status: str)
        """
        equity = self.broker.get_account_equity()
        if self.peak_equity is None or equity > self.peak_equity:
            self.peak_equity = equity

        drawdown = (self.peak_equity - equity) / self.peak_equity

        if drawdown >= HARD_MAX_PORTFOLIO_DRAWDOWN:
            return False, f"HARD_HALT: drawdown={drawdown:.1%} >= {HARD_MAX_PORTFOLIO_DRAWDOWN:.0%}"

        soft_limit = self.config.get("max_drawdown_tolerance", 0.15)
        if drawdown >= soft_limit:
            return False, f"SOFT_HALT: drawdown={drawdown:.1%} >= {soft_limit:.0%}"

        return True, f"OK: drawdown={drawdown:.1%}, equity=${equity:,.0f}"
```

