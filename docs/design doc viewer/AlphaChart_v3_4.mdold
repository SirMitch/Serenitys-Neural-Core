### 5.3 Core Data Objects

```python
from dataclasses import dataclass, field
from typing import Optional
from enum import Enum

class Direction(Enum):
    LONG  = "LONG"
    SHORT = "SHORT"
    FLAT  = "FLAT"

class Regime(Enum):
    TRENDING_UP   = "TRENDING_UP"
    TRENDING_DOWN = "TRENDING_DOWN"
    RANGING       = "RANGING"
    VOLATILE      = "VOLATILE"

@dataclass
class TimeframeContext:
    timeframe: str                  # "3mo", "1mo", "2wk", "1wk", "daily", "intraday"
    trend_direction: Direction
    trend_strength: float           # 0.0–1.0
    key_levels: list[float]         # support/resistance
    momentum_score: float           # -1.0 to +1.0
    structure_intact: bool          # higher-high/lower-low structure
    confidence: float               # degrades at higher timeframes

@dataclass
class FinRLXOutput:
    agent_id: str
    action_probs: dict              # {"BUY": 0.7, "SELL": 0.1, "HOLD": 0.2}
    q_value: float
    agent_confidence: float
    regime_trained_on: Regime

@dataclass
class TradingSignal:
    ticker: str
    direction: Direction
    timeframe: str
    conviction_score: float         # 0.0–1.0
    quality_score: float            # from LLM gate
    regime: Regime
    position_size_pct: float
    stop_loss_price: float
    profit_target_price: float
    entry_price: float
    risk_flags: list[str]
    narrative: str                  # LLM synthesis
    timeframe_contexts: list[TimeframeContext]
    finrl_x_outputs: list[FinRLXOutput]
    approved: bool = False
    order_id: Optional[str] = None
    timestamp: str = ""
```

