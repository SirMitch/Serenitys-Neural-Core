### 10.5 Performance Tab

```python
def render_performance_tab(trade_log: list[dict]):
    import plotly.graph_objects as go
    import plotly.express as px

    st.subheader("📈 Performance Analytics")

    # KPI row
    total_trades  = len(trade_log)
    wins          = sum(1 for t in trade_log if t["won"])
    win_rate      = wins / total_trades if total_trades else 0
    total_pnl     = sum(t["pnl_pct"] for t in trade_log)
    avg_win       = (sum(t["pnl_pct"] for t in trade_log if t["won"])
                     / max(wins, 1))
    avg_loss      = (sum(t["pnl_pct"] for t in trade_log if not t["won"])
                     / max(total_trades - wins, 1))
    profit_factor = abs(avg_win * wins / (avg_loss * (total_trades - wins) + 1e-9))

    cols = st.columns(5)
    cols[0].metric("Total Trades", total_trades)
    cols[1].metric("Win Rate",   f"{win_rate:.1%}")
    cols[2].metric("Total P&L",  f"{total_pnl:.1%}")
    cols[3].metric("Avg Win",    f"{avg_win:.2%}")
    cols[4].metric("Profit Factor", f"{profit_factor:.2f}")

    # Equity curve
    equity_curve = []
    eq = 1.0
    for t in trade_log:
        eq *= (1 + t["pnl_pct"])
        equity_curve.append(eq)

    fig = go.Figure()
    fig.add_trace(go.Scatter(
        y=equity_curve, mode="lines",
        name="Portfolio", line=dict(color="#00C851", width=2)
    ))
    fig.update_layout(title="Equity Curve", height=300,
                      paper_bgcolor="rgba(0,0,0,0)",
                      plot_bgcolor="rgba(0,0,0,0)")
    st.plotly_chart(fig, use_container_width=True)

    # Win rate by regime and ticker
    col_r, col_t = st.columns(2)
    with col_r:
        regime_stats = {}
        for t in trade_log:
            r = t.get("regime", "UNKNOWN")
            regime_stats.setdefault(r, {"wins": 0, "total": 0})
            regime_stats[r]["total"] += 1
            if t["won"]:
                regime_stats[r]["wins"] += 1
        fig2 = px.bar(
            x=list(regime_stats.keys()),
            y=[v["wins"]/max(v["total"],1) for v in regime_stats.values()],
            title="Win Rate by Regime", labels={"y": "Win Rate", "x": "Regime"}
        )
        st.plotly_chart(fig2, use_container_width=True)
    with col_t:
        ticker_stats = {}
        for t in trade_log:
            ticker = t.get("ticker", "?")
            ticker_stats.setdefault(ticker, {"wins": 0, "total": 0})
            ticker_stats[ticker]["total"] += 1
            if t["won"]:
                ticker_stats[ticker]["wins"] += 1
        top_tickers = sorted(ticker_stats.items(),
                             key=lambda x: x[1]["total"], reverse=True)[:10]
        fig3 = px.bar(
            x=[t[0] for t in top_tickers],
            y=[t[1]["wins"]/max(t[1]["total"],1) for t in top_tickers],
            title="Win Rate by Ticker (Top 10)"
        )
        st.plotly_chart(fig3, use_container_width=True)
```

