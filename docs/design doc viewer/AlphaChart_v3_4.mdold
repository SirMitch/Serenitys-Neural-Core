## 4. Portfolio Integration & Scanning

### 4.1 Broker Connection

**Primary: Alpaca Markets**

```python
import alpaca_trade_api as tradeapi

class AlpacaConnector:
    def __init__(self, api_key, secret_key, base_url):
        self.api = tradeapi.REST(api_key, secret_key, base_url)

    def get_portfolio_tickers(self) -> list[str]:
        positions = self.api.list_positions()
        return [p.symbol for p in positions]

    def get_account_equity(self) -> float:
        account = self.api.get_account()
        return float(account.equity)

    def submit_paper_order(self, symbol, qty, side, order_type="market",
                           time_in_force="day", limit_price=None):
        return self.api.submit_order(
            symbol=symbol, qty=qty, side=side,
            type=order_type, time_in_force=time_in_force,
            limit_price=limit_price
        )

    def get_open_orders(self) -> list:
        return self.api.list_orders(status="open")

    def cancel_order(self, order_id: str):
        self.api.cancel_order(order_id)
```

**Fallback: IBKR via ib_insync**

```python
from ib_insync import IB, Stock, MarketOrder, LimitOrder

class IBKRConnector:
    def __init__(self, host="127.0.0.1", port=7497, client_id=1):
        self.ib = IB()
        self.ib.connect(host, port, clientId=client_id)

    def get_portfolio_tickers(self) -> list[str]:
        positions = self.ib.positions()
        return [p.contract.symbol for p in positions]

    def submit_paper_order(self, symbol, qty, side, limit_price=None):
        contract = Stock(symbol, "SMART", "USD")
        if limit_price:
            order = LimitOrder(side.upper(), qty, limit_price)
        else:
            order = MarketOrder(side.upper(), qty)
        trade = self.ib.placeOrder(contract, order)
        return trade
```

---

### 4.2 Portfolio Scanning Engine

```python
class PortfolioScanner:
    def __init__(self, broker_connector, watchlist: list[str],
                 scan_interval_minutes: int = 15):
        self.broker = broker_connector
        self.watchlist = watchlist
        self.scan_interval = scan_interval_minutes
        self.signal_queue = []

    def get_scan_universe(self) -> list[str]:
        portfolio_tickers = self.broker.get_portfolio_tickers()
        all_tickers = list(set(portfolio_tickers + self.watchlist))
        return sorted(all_tickers)

    def run_scan_cycle(self, signal_pipeline) -> list[dict]:
        universe = self.get_scan_universe()
        signals = []
        for ticker in universe:
            try:
                signal = signal_pipeline.generate_signal(ticker)
                signals.append(signal)
            except Exception as e:
                log_error(f"[SCAN] {ticker} failed: {e}")
        self.signal_queue = sorted(signals,
            key=lambda x: x["conviction_score"], reverse=True)
        return self.signal_queue

    def schedule(self, signal_pipeline):
        """Runs run_scan_cycle every scan_interval minutes."""
        import schedule, time
        schedule.every(self.scan_interval).minutes.do(
            self.run_scan_cycle, signal_pipeline)
        while True:
            schedule.run_pending()
            time.sleep(30)
```

---

### 4.3 Signal Prioritization & Presentation

After each scan cycle, signals are ranked by **Conviction Score** and filtered by the **Active Quality Gate**. The GUI presents a prioritized signal table:

| Rank | Ticker | Direction | Timeframe | Conviction | Quality Score | Regime | Action |
|---|---|---|---|---|---|---|---|
| 1 | NVDA | LONG | Daily | 0.87 | 0.82 | TRENDING_UP | [Approve] |
| 2 | AAPL | SHORT | Daily | 0.73 | 0.71 | RANGING | [Approve] |
| ... | | | | | | | |

Signals below threshold are shown in a separate "Below Threshold" panel (collapsed by default) for transparency.

