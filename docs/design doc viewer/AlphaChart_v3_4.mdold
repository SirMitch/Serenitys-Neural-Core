## 6. Core Engines

### 6.1 Data Fetcher

```python
import yfinance as yf
import pandas as pd
from functools import lru_cache
import hashlib, time

TIMEFRAME_MAP = {
    "3mo":      {"period": "3mo",  "interval": "1d"},
    "1mo":      {"period": "1mo",  "interval": "1d"},
    "2wk":      {"period": "60d",  "interval": "1d"},
    "1wk":      {"period": "30d",  "interval": "1d"},
    "daily":    {"period": "1y",   "interval": "1d"},
    "60m":      {"period": "30d",  "interval": "60m"},
    "15m":      {"period": "7d",   "interval": "15m"},
}

TTL_SECONDS = {
    "3mo": 86400, "1mo": 86400, "2wk": 3600,
    "1wk": 3600,  "daily": 900, "60m": 300, "15m": 60
}

class DataFetcher:
    def __init__(self):
        self._cache = {}

    def fetch(self, ticker: str, timeframe: str) -> pd.DataFrame:
        cache_key = f"{ticker}_{timeframe}"
        now = time.time()
        if cache_key in self._cache:
            data, ts = self._cache[cache_key]
            if now - ts < TTL_SECONDS[timeframe]:
                return data
        params = TIMEFRAME_MAP[timeframe]
        df = yf.download(ticker, period=params["period"],
                         interval=params["interval"],
                         auto_adjust=True, progress=False)
        df.dropna(inplace=True)
        self._cache[cache_key] = (df, now)
        return df

    def fetch_all_timeframes(self, ticker: str) -> dict[str, pd.DataFrame]:
        return {tf: self.fetch(ticker, tf) for tf in TIMEFRAME_MAP}
```

---

### 6.2 Multi-Timeframe Analyzer

The multi-timeframe analyzer enforces the **higher-timeframe-as-anchor** discipline. A LONG entry signal is only valid if the daily and weekly timeframes do not show an active TRENDING_DOWN regime. Intraday signals provide timing; weekly/monthly signals provide permission.

```python
import ta  # technical analysis library

class MultiTimeframeAnalyzer:

    CONFIDENCE_DECAY = {
        "3mo": 0.50, "1mo": 0.60, "2wk": 0.70,
        "1wk": 0.75, "daily": 0.85, "intraday": 0.95
    }

    def analyze(self, ticker: str,
                all_data: dict[str, pd.DataFrame]) -> list[TimeframeContext]:
        contexts = []
        for tf, df in all_data.items():
            if df.empty or len(df) < 20:
                continue
            ctx = self._analyze_single(tf, df)
            contexts.append(ctx)
        return contexts

    def _analyze_single(self, timeframe: str,
                        df: pd.DataFrame) -> TimeframeContext:
        close = df["Close"]
        high  = df["High"]
        low   = df["Low"]

        # Trend detection: EMA 20/50 relationship
        ema20 = ta.trend.EMAIndicator(close, window=20).ema_indicator()
        ema50 = ta.trend.EMAIndicator(close, window=50).ema_indicator()
        last_ema20 = ema20.iloc[-1]
        last_ema50 = ema50.iloc[-1]

        if last_ema20 > last_ema50 * 1.005:
            trend = Direction.LONG
        elif last_ema20 < last_ema50 * 0.995:
            trend = Direction.SHORT
        else:
            trend = Direction.FLAT

        # Trend strength: ADX
        adx = ta.trend.ADXIndicator(high, low, close).adx()
        strength = min(float(adx.iloc[-1]) / 50.0, 1.0)

        # Momentum: MACD histogram normalized
        macd = ta.trend.MACD(close)
        hist = macd.macd_diff().iloc[-1]
        atr  = ta.volatility.AverageTrueRange(high, low, close).average_true_range().iloc[-1]
        momentum = float(hist / atr) if atr > 0 else 0.0
        momentum = max(-1.0, min(1.0, momentum))

        # Key levels: recent swing highs/lows (simplified)
        key_levels = self._compute_key_levels(df)

        # Structure: higher-highs / lower-lows check
        recent_highs = high.rolling(5).max()
        structure_intact = bool(
            (trend == Direction.LONG  and recent_highs.iloc[-1] > recent_highs.iloc[-5]) or
            (trend == Direction.SHORT and low.rolling(5).min().iloc[-1] < low.rolling(5).min().iloc[-5]) or
            trend == Direction.FLAT
        )

        return TimeframeContext(
            timeframe=timeframe,
            trend_direction=trend,
            trend_strength=strength,
            key_levels=key_levels,
            momentum_score=momentum,
            structure_intact=structure_intact,
            confidence=self.CONFIDENCE_DECAY.get(timeframe, 0.70)
        )

    def _compute_key_levels(self, df: pd.DataFrame,
                            window: int = 20) -> list[float]:
        highs = df["High"].rolling(window).max().dropna().unique()
        lows  = df["Low"].rolling(window).min().dropna().unique()
        levels = sorted(set(list(highs[-3:]) + list(lows[-3:])))
        return levels

    def get_anchor_bias(self, contexts: list[TimeframeContext]) -> Direction:
        """
        Higher-timeframe consensus (3mo, 1mo, 1wk) determines anchor bias.
        LONG entries blocked if anchor bias is SHORT/FLAT with strong conviction.
        """
        anchor_tfs = ["3mo", "1mo", "1wk"]
        anchor_ctxs = [c for c in contexts if c.timeframe in anchor_tfs]
        if not anchor_ctxs:
            return Direction.FLAT
        votes = {"LONG": 0.0, "SHORT": 0.0, "FLAT": 0.0}
        for ctx in anchor_ctxs:
            weight = ctx.confidence * ctx.trend_strength
            votes[ctx.trend_direction.value] += weight
        return Direction[max(votes, key=votes.get)]
```

---

### 6.3 Regime Detector

```python
class RegimeDetector:

    def detect(self, df_daily: pd.DataFrame) -> Regime:
        close = df_daily["Close"]
        high  = df_daily["High"]
        low   = df_daily["Low"]

        adx = ta.trend.ADXIndicator(high, low, close).adx().iloc[-1]
        ema20 = ta.trend.EMAIndicator(close, 20).ema_indicator().iloc[-1]
        ema50 = ta.trend.EMAIndicator(close, 50).ema_indicator().iloc[-1]
        bb    = ta.volatility.BollingerBands(close)
        bb_width = (bb.bollinger_hband() - bb.bollinger_lband()) / close
        vol_ratio = float(bb_width.iloc[-1] / bb_width.rolling(20).mean().iloc[-1])

        if vol_ratio > 1.5:
            return Regime.VOLATILE
        if adx > 25:
            return Regime.TRENDING_UP if ema20 > ema50 else Regime.TRENDING_DOWN
        return Regime.RANGING

    def get_ensemble_weights(self, regime: Regime) -> dict[str, float]:
        """
        Per-regime calibrated ensemble weights.
        TRENDING_DOWN applies extra penalty to LONG-biased models.
        """
        weights = {
            Regime.TRENDING_UP:   {"finrl_x": 0.30, "multi_tf": 0.30,
                                   "ml_factor": 0.20, "regime_score": 0.20},
            Regime.TRENDING_DOWN: {"finrl_x": 0.20, "multi_tf": 0.40,
                                   "ml_factor": 0.20, "regime_score": 0.20},
            Regime.RANGING:       {"finrl_x": 0.25, "multi_tf": 0.20,
                                   "ml_factor": 0.35, "regime_score": 0.20},
            Regime.VOLATILE:      {"finrl_x": 0.15, "multi_tf": 0.25,
                                   "ml_factor": 0.20, "regime_score": 0.40},
        }
        return weights[regime]
```

---

### 6.4 FinRL-X Engine

FinRL-X is treated as an **expert sub-strategy signal source** within the ensemble — equivalent to how a hedge fund treats a systematic sub-pod's output. The FinRL-X agents are trained per-regime and per-ticker cluster. Their action probabilities and Q-values are features fed into the ensemble, not final trade decisions.

```python
from finrl.agents.stablebaselines3.models import DRLAgent
from finrl.meta.env_stock_trading.env_stocktrading import StockTradingEnv
import numpy as np

class FinRLXEngine:
    """
    Wraps multiple FinRL-X PPO/SAC agents (one per regime).
    Agents are loaded from checkpoint. Inference only during live operation.
    Retraining triggered by performance degradation or schedule.
    """

    def __init__(self, agent_checkpoints: dict[Regime, str]):
        self.agents = {}
        for regime, path in agent_checkpoints.items():
            self.agents[regime] = self._load_agent(path)

    def _load_agent(self, checkpoint_path: str):
        from stable_baselines3 import PPO
        return PPO.load(checkpoint_path)

    def get_signal(self, regime: Regime,
                   state_vector: np.ndarray) -> FinRLXOutput:
        agent = self.agents.get(regime)
        if agent is None:
            return self._null_output(regime)

        action, _ = agent.predict(state_vector, deterministic=True)
        # Get action probabilities from policy distribution
        obs_tensor = agent.policy.obs_to_tensor(
            state_vector.reshape(1, -1))[0]
        dist = agent.policy.get_distribution(obs_tensor)
        probs = dist.distribution.probs.detach().numpy()[0]
        action_labels = ["SELL", "HOLD", "BUY"]
        action_probs = {a: float(p) for a, p in zip(action_labels, probs)}

        return FinRLXOutput(
            agent_id=f"ppo_{regime.value}",
            action_probs=action_probs,
            q_value=float(probs.max()),
            agent_confidence=float(probs.max() - probs.min()),
            regime_trained_on=regime
        )

    def _null_output(self, regime: Regime) -> FinRLXOutput:
        return FinRLXOutput(
            agent_id="null",
            action_probs={"BUY": 0.33, "HOLD": 0.34, "SELL": 0.33},
            q_value=0.0, agent_confidence=0.0,
            regime_trained_on=regime
        )

    def build_state_vector(self, df: pd.DataFrame,
                           timeframe_contexts: list[TimeframeContext],
                           regime: Regime) -> np.ndarray:
        """
        Constructs the state vector passed to FinRL-X agents.
        Features: price ratios, volume, ATR-normalized momentum,
        EMA spreads, regime encoding, multi-TF momentum summary.
        """
        close = df["Close"]
        features = []

        # Price momentum
        for window in [5, 10, 20, 50]:
            ret = (close.iloc[-1] / close.iloc[-window] - 1)
            features.append(float(ret))

        # Volume ratio
        vol_ma = df["Volume"].rolling(20).mean().iloc[-1]
        features.append(float(df["Volume"].iloc[-1] / vol_ma))

        # ATR normalized
        atr = ta.volatility.AverageTrueRange(
            df["High"], df["Low"], close).average_true_range().iloc[-1]
        features.append(float(atr / close.iloc[-1]))

        # Multi-TF momentum summary
        for ctx in sorted(timeframe_contexts,
                          key=lambda x: x.confidence):
            features.append(float(ctx.momentum_score))
            features.append(float(ctx.trend_strength))

        # Regime one-hot
        regime_encoding = [0.0, 0.0, 0.0, 0.0]
        regime_idx = list(Regime).index(regime)
        regime_encoding[regime_idx] = 1.0
        features.extend(regime_encoding)

        return np.array(features, dtype=np.float32)

    def retrain(self, regime: Regime, training_df: pd.DataFrame,
                config: dict):
        """
        Retrains the agent for the specified regime using recent data.
        Called by the Learning Engine on performance degradation trigger.
        """
        env = StockTradingEnv(df=training_df, **config["env_kwargs"])
        agent = DRLAgent(env=env)
        model = agent.get_model("ppo", model_kwargs=config["ppo_kwargs"])
        trained = agent.train_model(
            model=model, tb_log_name=f"ppo_{regime.value}",
            total_timesteps=config.get("total_timesteps", 50000)
        )
        self.agents[regime] = trained
        return trained
```

---

### 6.5 ML Factor Model

```python
from sklearn.ensemble import GradientBoostingClassifier
import joblib

class MLFactorModel:
    """
    Gradient boosting classifier trained on engineered factor features.
    Outputs probability of positive return over prediction horizon.
    Trained offline; retrained on RLMF trigger.
    """

    def __init__(self, model_path: str):
        self.model = joblib.load(model_path)

    def compute_features(self, df: pd.DataFrame) -> np.ndarray:
        close = df["Close"]
        high  = df["High"]
        low   = df["Low"]
        vol   = df["Volume"]

        # Momentum factors
        mom_5  = close.pct_change(5).iloc[-1]
        mom_20 = close.pct_change(20).iloc[-1]
        mom_60 = close.pct_change(60).iloc[-1] if len(df) > 60 else 0.0

        # Mean-reversion factor
        zscore_20 = (close.iloc[-1] - close.rolling(20).mean().iloc[-1]) / \
                    (close.rolling(20).std().iloc[-1] + 1e-9)

        # Volatility factor
        realized_vol = close.pct_change().rolling(20).std().iloc[-1]
        hist_vol_ratio = realized_vol / (close.pct_change().rolling(60).std().iloc[-1] + 1e-9)

        # Volume factor
        vol_surge = vol.iloc[-1] / (vol.rolling(20).mean().iloc[-1] + 1e-9)

        # Range factor: today's range vs ATR
        today_range = (high.iloc[-1] - low.iloc[-1])
        atr = ta.volatility.AverageTrueRange(high, low, close).average_true_range().iloc[-1]
        range_factor = today_range / (atr + 1e-9)

        return np.array([
            mom_5, mom_20, mom_60, zscore_20,
            realized_vol, hist_vol_ratio, vol_surge, range_factor
        ], dtype=np.float32)

    def predict_score(self, df: pd.DataFrame) -> float:
        """Returns probability of positive outcome [0, 1]."""
        features = self.compute_features(df).reshape(1, -1)
        prob = self.model.predict_proba(features)[0][1]
        return float(prob)
```

---

### 6.6 Ensemble Aggregator

```python
class EnsembleAggregator:
    def aggregate(self,
                  finrl_x_output: FinRLXOutput,
                  multi_tf_contexts: list[TimeframeContext],
                  regime: Regime,
                  ml_factor_score: float,
                  regime_weights: dict,
                  direction_constraint: Direction,
                  user_weights: dict = None) -> tuple[float, Direction]:
        """
        Computes unified conviction score and direction.
        Returns (conviction_score, direction).
        """
        # FinRL-X score: BUY probability for LONG conviction
        frl_buy_prob  = finrl_x_output.action_probs.get("BUY",  0.33)
        frl_sell_prob = finrl_x_output.action_probs.get("SELL", 0.33)
        frl_score = frl_buy_prob - frl_sell_prob  # range: -1 to +1

        # Multi-TF weighted momentum
        tf_score = 0.0
        tf_weight_sum = 0.0
        for ctx in multi_tf_contexts:
            w = ctx.confidence * ctx.trend_strength
            tf_score += ctx.momentum_score * w
            tf_weight_sum += w
        tf_score = tf_score / tf_weight_sum if tf_weight_sum > 0 else 0.0

        # ML Factor score: centered to -1..+1
        ml_score = (ml_factor_score - 0.5) * 2.0

        # Regime confidence score (from regime strength)
        regime_score = 0.5  # neutral placeholder; override with regime model output

        w = user_weights or regime_weights
        # Normalize weights
        total_w = sum(w.values())
        wn = {k: v / total_w for k, v in w.items()}

        raw = (wn["finrl_x"]   * frl_score +
               wn["multi_tf"]  * tf_score  +
               wn["ml_factor"] * ml_score  +
               wn["regime_score"] * regime_score)

        # Determine direction
        direction = Direction.LONG if raw > 0 else (
                    Direction.SHORT if raw < 0 else Direction.FLAT)

        # Enforce higher-timeframe anchor constraint
        if direction_constraint == Direction.SHORT and direction == Direction.LONG:
            raw *= 0.40  # Penalty for fighting higher-TF trend
        if direction_constraint == Direction.LONG and direction == Direction.SHORT:
            raw *= 0.40

        conviction = min(abs(raw), 1.0)
        return conviction, direction
```

---

### 6.7 Deterministic Safety Filter

The safety filter applies rule-based hard blocks. It runs **before** the LLM gate and **before** any order is staged. Rules are immutable — they cannot be disabled by any user configuration.

```python
from datetime import datetime, timedelta
import pandas_market_calendars as mcal

class DeterministicSafetyFilter:
    EARNINGS_BLACKOUT_DAYS = 2

    def __init__(self, earnings_calendar: dict):
        self.earnings_calendar = earnings_calendar  # {ticker: [date, ...]}

    def check(self, ticker: str, signal: dict,
              df_daily: pd.DataFrame) -> tuple[bool, list[str]]:
        """
        Returns (passed: bool, block_reasons: list[str])
        """
        blocks = []

        # 1. Earnings blackout
        today = datetime.today().date()
        for edate in self.earnings_calendar.get(ticker, []):
            if abs((edate - today).days) <= self.EARNINGS_BLACKOUT_DAYS:
                blocks.append(f"EARNINGS_BLACKOUT: {edate}")

        # 2. Gap filter — no entries after >3% overnight gap
        if len(df_daily) >= 2:
            prev_close = df_daily["Close"].iloc[-2]
            today_open = df_daily["Open"].iloc[-1]
            gap_pct = abs(today_open / prev_close - 1)
            if gap_pct > 0.03:
                blocks.append(f"GAP_FILTER: {gap_pct:.1%} overnight gap")

        # 3. Liquidity — require min average volume
        avg_vol = df_daily["Volume"].rolling(20).mean().iloc[-1]
        if avg_vol < 500_000:
            blocks.append(f"LOW_LIQUIDITY: avg_vol={avg_vol:.0f}")

        # 4. Halted / suspended check (via broker API flag)
        if signal.get("market_status") == "HALTED":
            blocks.append("MARKET_HALTED")

        # 5. Weekend / market-closed check
        nyse = mcal.get_calendar("NYSE")
        schedule = nyse.schedule(start_date=today, end_date=today)
        if schedule.empty:
            blocks.append("MARKET_CLOSED")

        # 6. Max concurrent trades check (handled in OrderManager, not here)

        passed = len(blocks) == 0
        return passed, blocks
```

---

## 7. LLM Intelligence Layer

### 7.1 Role: Senior Quantitative Analyst

The LLM layer in v3.4 does **not** cast directional votes. Its role is precisely that of a senior quantitative analyst reviewing a trade committee dossier:

- **Evaluate signal quality** — does the evidence cohesively support the proposed trade?
- **Identify risk flags** — conflicting timeframes, regime mismatches, over-reliance on single signals, known failure modes
- **Synthesize a narrative** — a concise, auditable explanation of why the trade passes or fails quality review
- **Return a structured score** — not a direction, a quality assessment

This eliminates the directional-voting failure mode and removes the LLM from the critical decision path for direction, while keeping it in the loop for quality gating.

---

### 7.2 LLM Quality Gate

```python
import anthropic
import json

SYSTEM_PROMPT = """
You are a senior quantitative analyst at a top-tier hedge fund.
You are reviewing a proposed algorithmic trade signal dossier.
Your job is NOT to decide trade direction — the ensemble models have already done that.
Your job is to evaluate the QUALITY and COHERENCE of the signal evidence.

You will return a structured JSON evaluation with:
- quality_score: float [0.0, 1.0] — overall signal quality
- confidence_in_quality: float [0.0, 1.0] — how confident you are in your evaluation
- risk_flags: list[str] — any red flags (be specific)
- key_strengths: list[str] — what supports the trade thesis
- key_weaknesses: list[str] — what undermines it
- narrative: str — one concise paragraph (max 100 words) summarizing your evaluation
- recommendation: str — one of: "APPROVE", "APPROVE_WITH_CAUTION", "REJECT"

You are rigorous, skeptical, and data-driven. You penalize:
- Single-factor signals (RSI alone, volume alone)
- Higher-timeframe conflict with proposed direction
- Regime mismatch between trained model and current conditions
- Low FinRL-X agent confidence combined with low ML factor score
- Recent prediction failures on this ticker in the memory context

You reward:
- Multi-timeframe alignment
- High FinRL-X confidence in the current regime
- Strong factor confirmation
- Historical success patterns from RAG memory
"""

class LLMQualityGate:
    def __init__(self, model: str = "claude-opus-4-6"):
        self.client = anthropic.Anthropic()
        self.model = model

    def evaluate(self, ticker: str,
                 proposed_direction: Direction,
                 conviction_score: float,
                 multi_tf_contexts: list[TimeframeContext],
                 finrl_x_output: FinRLXOutput,
                 ml_factor_score: float,
                 regime: Regime,
                 rag_memory_context: str,
                 risk_flags_pre: list[str]) -> dict:

        dossier = self._build_dossier(
            ticker, proposed_direction, conviction_score,
            multi_tf_contexts, finrl_x_output, ml_factor_score,
            regime, rag_memory_context, risk_flags_pre
        )

        response = self.client.messages.create(
            model=self.model,
            max_tokens=800,
            system=SYSTEM_PROMPT,
            messages=[{"role": "user", "content": dossier}]
        )

        raw = response.content[0].text
        try:
            result = json.loads(raw)
        except json.JSONDecodeError:
            # Fallback: extract JSON block
            import re
            match = re.search(r'\{.*\}', raw, re.DOTALL)
            result = json.loads(match.group()) if match else self._default_reject()

        return result

    def _build_dossier(self, ticker, direction, conviction,
                       contexts, finrl_x, ml_score, regime,
                       rag_context, pre_flags) -> str:
        tf_summary = "\n".join([
            f"  {c.timeframe}: {c.trend_direction.value} "
            f"(strength={c.trend_strength:.2f}, momentum={c.momentum_score:.2f}, "
            f"confidence={c.confidence:.2f})"
            for c in sorted(contexts, key=lambda x: x.confidence, reverse=True)
        ])
        return f"""
=== TRADE SIGNAL DOSSIER ===
Ticker: {ticker}
Proposed Direction: {direction.value}
Ensemble Conviction Score: {conviction:.3f}
Current Market Regime: {regime.value}

=== MULTI-TIMEFRAME ANALYSIS ===
{tf_summary}

=== FinRL-X EXPERT SIGNAL ===
Agent: {finrl_x.agent_id}
Action Probabilities: {finrl_x.action_probs}
Agent Confidence: {finrl_x.agent_confidence:.3f}
Regime Trained On: {finrl_x.regime_trained_on.value}

=== ML FACTOR MODEL ===
Factor Score (probability of positive return): {ml_score:.3f}

=== PRE-FILTER RISK FLAGS ===
{chr(10).join(pre_flags) if pre_flags else "None"}

=== HISTORICAL MEMORY CONTEXT (RAG) ===
{rag_context}

=== YOUR TASK ===
Evaluate the quality of this signal and return your structured JSON assessment.
Do not decide direction. Evaluate quality and coherence of the evidence.
"""

    def _default_reject(self) -> dict:
        return {
            "quality_score": 0.0,
            "confidence_in_quality": 0.0,
            "risk_flags": ["LLM_PARSE_FAILURE"],
            "key_strengths": [],
            "key_weaknesses": ["Could not parse LLM response"],
            "narrative": "LLM evaluation failed; signal rejected by default.",
            "recommendation": "REJECT"
        }
```

---

### 7.3 Quality Gate Decision Logic

```python
class SignalQualityDecision:
    def decide(self, llm_result: dict,
               conviction_score: float,
               config: dict) -> tuple[bool, str]:
        """
        Returns (approved: bool, reason: str).
        """
        quality = llm_result.get("quality_score", 0.0)
        rec     = llm_result.get("recommendation", "REJECT")
        flags   = llm_result.get("risk_flags", [])

        min_quality = config["min_quality_score"]
        min_conv    = config["conviction_threshold"]

        if rec == "REJECT":
            return False, f"LLM_REJECT: quality={quality:.2f}"

        if quality < min_quality:
            return False, f"QUALITY_BELOW_THRESHOLD: {quality:.2f} < {min_quality:.2f}"

        if conviction_score < min_conv:
            return False, f"CONVICTION_BELOW_THRESHOLD: {conviction_score:.2f}"

        # Critical flags always block
        critical_flags = [
            "REGIME_MISMATCH", "EARNINGS_BLACKOUT",
            "EXTREME_VOLATILITY", "CIRCUIT_BREAKER"
        ]
        for flag in flags:
            if any(cf in flag for cf in critical_flags):
                return False, f"CRITICAL_FLAG: {flag}"

        return True, "APPROVED"
```

---

## 8. Learning & Adaptation Engine

### 8.1 Architecture

The learning engine has three interconnected components:

1. **RAG Memory Store** — ChromaDB vector store of trade outcomes, patterns, and market contexts
2. **RLMF Engine** — Reward shaping feedback from trade outcomes to FinRL-X agents
3. **ML Model Retrainer** — Scheduled and performance-triggered retraining of the ML factor model and FinRL-X agents

---

### 8.2 RAG Memory Store

```python
import chromadb
from chromadb.utils import embedding_functions
import json
from datetime import datetime

class RAGMemoryStore:
    def __init__(self, persist_path: str = "./alphachart_memory"):
        self.client = chromadb.PersistentClient(path=persist_path)
        self.embed_fn = embedding_functions.DefaultEmbeddingFunction()
        self.collection = self.client.get_or_create_collection(
            name="trade_memory",
            embedding_function=self.embed_fn
        )

    def record_outcome(self, signal: TradingSignal,
                       outcome: dict):
        """
        Records completed trade with outcome for future retrieval.
        outcome = {
            "pnl_pct": float,
            "won": bool,
            "hold_duration_days": int,
            "exit_reason": str,
            "actual_regime_at_exit": str
        }
        """
        doc_text = (
            f"Ticker: {signal.ticker} | Direction: {signal.direction.value} | "
            f"Regime: {signal.regime.value} | Conviction: {signal.conviction_score:.3f} | "
            f"Quality: {signal.quality_score:.3f} | "
            f"TF_Contexts: {[(c.timeframe, c.trend_direction.value) for c in signal.timeframe_contexts]} | "
            f"Outcome: {'WIN' if outcome['won'] else 'LOSS'} | "
            f"PnL: {outcome['pnl_pct']:.2%} | "
            f"Hold: {outcome['hold_duration_days']}d | "
            f"Exit: {outcome['exit_reason']}"
        )
        metadata = {
            "ticker":      signal.ticker,
            "direction":   signal.direction.value,
            "regime":      signal.regime.value,
            "won":         str(outcome["won"]),
            "pnl_pct":     str(outcome["pnl_pct"]),
            "timestamp":   datetime.utcnow().isoformat(),
            "conviction":  str(signal.conviction_score),
        }
        doc_id = f"{signal.ticker}_{signal.timestamp}_{datetime.utcnow().timestamp()}"
        self.collection.add(
            documents=[doc_text],
            metadatas=[metadata],
            ids=[doc_id]
        )

    def retrieve_context(self, ticker: str, regime: Regime,
                         direction: Direction,
                         n_results: int = 5) -> str:
        """
        Retrieves relevant historical patterns for LLM dossier.
        Cross-ticker learning: also retrieves regime-matched patterns
        from other tickers.
        """
        query = (
            f"Ticker {ticker} {direction.value} trade in {regime.value} regime"
        )
        results = self.collection.query(
            query_texts=[query],
            n_results=n_results,
            where={"regime": regime.value}  # regime-filtered
        )
        if not results["documents"] or not results["documents"][0]:
            return "No relevant historical memory available."

        lines = []
        for doc, meta in zip(results["documents"][0],
                             results["metadatas"][0]):
            lines.append(
                f"[{'SAME_TICKER' if meta['ticker'] == ticker else 'CROSS_TICKER'}] "
                f"{doc}"
            )
        return "\n".join(lines)

    def get_ticker_win_rate(self, ticker: str,
                            last_n: int = 20) -> float:
        results = self.collection.query(
            query_texts=[f"Trade on {ticker}"],
            n_results=last_n,
            where={"ticker": ticker}
        )
        if not results["metadatas"] or not results["metadatas"][0]:
            return 0.0
        wins = sum(1 for m in results["metadatas"][0]
                   if m.get("won") == "True")
        return wins / len(results["metadatas"][0])
```

---

### 8.3 RLMF Engine

```python
class RLMFEngine:
    """
    Reward shaping for FinRL-X agents based on realized trade outcomes.
    Implements a simple experience replay buffer that feeds back to FinRL-X
    training on retrain events.
    """

    def __init__(self, reward_scale: float = 1.0):
        self.reward_scale = reward_scale
        self.experience_buffer = []  # list of (state, action, reward, next_state)

    def compute_reward(self, outcome: dict,
                       signal: TradingSignal) -> float:
        """
        Reward function combining:
        - realized PnL (primary)
        - quality score alignment (did high quality = high PnL?)
        - regime correctness
        """
        base_reward = outcome["pnl_pct"] * 100  # scale pct to reasonable range

        # Alignment bonus: reward when high quality score correlated with win
        if outcome["won"] and signal.quality_score > 0.75:
            base_reward += 0.5
        elif not outcome["won"] and signal.quality_score > 0.75:
            base_reward -= 0.5  # penalty for confident wrong calls

        # Regime match bonus
        if signal.regime.value == outcome.get("actual_regime_at_exit"):
            base_reward += 0.2

        return float(base_reward * self.reward_scale)

    def record_experience(self, state: np.ndarray,
                          action: int,
                          reward: float,
                          next_state: np.ndarray):
        self.experience_buffer.append((state, action, reward, next_state))
        # Rolling buffer: keep last 50,000 experiences
        if len(self.experience_buffer) > 50_000:
            self.experience_buffer.pop(0)

    def get_replay_batch(self, batch_size: int = 256) -> list:
        import random
        if len(self.experience_buffer) < batch_size:
            return self.experience_buffer
        return random.sample(self.experience_buffer, batch_size)
```

---

### 8.4 Retraining Trigger Logic

```python
class RetrainingController:
    def __init__(self, finrl_x: FinRLXEngine,
                 ml_model: MLFactorModel,
                 config: dict):
        self.finrl_x  = finrl_x
        self.ml_model = ml_model
        self.config   = config
        self.performance_window = []

    def record_result(self, won: bool, pnl_pct: float):
        self.performance_window.append({"won": won, "pnl": pnl_pct})
        if len(self.performance_window) > 50:
            self.performance_window.pop(0)

    def should_retrain(self) -> tuple[bool, str]:
        if len(self.performance_window) < 20:
            return False, "INSUFFICIENT_DATA"

        recent = self.performance_window[-20:]
        win_rate = sum(1 for r in recent if r["won"]) / len(recent)
        total_pnl = sum(r["pnl"] for r in recent)

        if win_rate < 0.45:
            return True, f"WIN_RATE_DEGRADED: {win_rate:.1%}"
        if total_pnl < self.config.get("retrain_pnl_threshold", -0.15):
            return True, f"PNL_DEGRADED: {total_pnl:.1%}"

        return False, "PERFORMANCE_OK"

    def trigger_retrain(self, regime: Regime,
                        training_data: pd.DataFrame):
        trigger, reason = self.should_retrain()
        if trigger:
            print(f"[RETRAIN] Triggering retraining: {reason}")
            self.finrl_x.retrain(regime, training_data, self.config)
            return True
        return False
```

