### 10.3 Signals Tab

The Signals tab shows the full ranked signal table with expandable rows:

```python
# Streamlit implementation sketch
import streamlit as st

def render_signals_tab(signals: list[dict], config: dict):
    st.subheader("📡 Active Signals")

    # Filter controls
    col1, col2, col3 = st.columns(3)
    with col1:
        show_below = st.checkbox("Show Below-Threshold", value=False)
    with col2:
        direction_filter = st.multiselect("Direction",
            ["LONG", "SHORT", "FLAT"], default=["LONG", "SHORT"])
    with col3:
        regime_filter = st.multiselect("Regime",
            ["TRENDING_UP", "TRENDING_DOWN", "RANGING", "VOLATILE"],
            default=["TRENDING_UP", "RANGING"])

    for sig in signals:
        if sig["direction"] not in direction_filter:
            continue
        if sig["regime"] not in regime_filter:
            continue
        if not show_below and sig["conviction_score"] < config["conviction_threshold"]:
            continue

        with st.expander(
            f"{sig['ticker']} | {sig['direction']} | "
            f"Conv: {sig['conviction_score']:.2f} | "
            f"Qual: {sig['quality_score']:.2f} | {sig['regime']}"
        ):
            col_a, col_b, col_c = st.columns(3)
            with col_a:
                st.metric("Entry", f"${sig['entry_price']:.2f}")
                st.metric("Stop", f"${sig['stop_loss_price']:.2f}")
            with col_b:
                st.metric("Target", f"${sig['profit_target_price']:.2f}")
                st.metric("Position Size",
                          f"{sig['position_size_pct']*100:.1f}%")
            with col_c:
                st.metric("Shares", str(sig.get("shares", "—")))
                st.metric("Risk $", f"${sig.get('risk_amount', 0):,.0f}")

            st.markdown(f"**Narrative:** {sig['narrative']}")

            if sig.get("risk_flags"):
                st.warning("Risk Flags: " + " | ".join(sig["risk_flags"]))

            # Multi-TF Summary
            st.markdown("**Timeframe Context:**")
            tf_data = {ctx["timeframe"]: ctx["trend_direction"]
                       for ctx in sig.get("timeframe_contexts", [])}
            st.json(tf_data)

            # Approve / Reject buttons
            col_btn1, col_btn2, _ = st.columns([1, 1, 4])
            with col_btn1:
                if st.button(f"✅ Approve", key=f"approve_{sig['ticker']}"):
                    st.session_state.approved_signals.append(sig)
                    st.success(f"Queued {sig['ticker']} for execution")
            with col_btn2:
                if st.button(f"❌ Reject", key=f"reject_{sig['ticker']}"):
                    st.info(f"Rejected {sig['ticker']}")
```

