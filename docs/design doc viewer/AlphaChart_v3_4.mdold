### 10.6 Order Management Flow

```python
class OrderManager:
    def __init__(self, broker_connector,
                 drawdown_guard: DrawdownGuard,
                 state_lock: dict):
        self.broker = broker_connector
        self.guard  = drawdown_guard
        self.state_lock = state_lock  # {ticker: bool}

    def execute_signal(self, signal: TradingSignal,
                       sizing: dict) -> dict:
        """
        Executes approved signal as paper trade.
        Returns order result.
        """
        # 1. Drawdown guard check
        allowed, status = self.guard.update_and_check()
        if not allowed:
            return {"status": "BLOCKED", "reason": status}

        # 2. State lock check — prevent duplicate orders
        if self.state_lock.get(signal.ticker, False):
            return {"status": "BLOCKED", "reason": "STATE_LOCKED"}
        self.state_lock[signal.ticker] = True

        # 3. Submit order
        try:
            side = "buy" if signal.direction == Direction.LONG else "sell"
            result = self.broker.submit_paper_order(
                symbol    = signal.ticker,
                qty       = sizing["shares"],
                side      = side,
                order_type= "limit",
                limit_price= round(signal.entry_price * 1.002, 2)
                              if side == "buy"
                              else round(signal.entry_price * 0.998, 2),
                time_in_force="day"
            )
            signal.order_id  = str(result.id)
            signal.approved  = True
            return {"status": "SUBMITTED", "order_id": signal.order_id,
                    "details": result}
        except Exception as e:
            self.state_lock[signal.ticker] = False
            return {"status": "ERROR", "reason": str(e)}

    def monitor_and_manage(self, open_signals: list[TradingSignal],
                           current_prices: dict):
        """
        Checks open positions against stop/target.
        Submits close orders when hit.
        """
        for sig in open_signals:
            price = current_prices.get(sig.ticker)
            if price is None:
                continue

            if sig.direction == Direction.LONG:
                if price <= sig.stop_loss_price:
                    self._close_position(sig, price, "STOP_LOSS")
                elif price >= sig.profit_target_price:
                    self._close_position(sig, price, "PROFIT_TARGET")
            elif sig.direction == Direction.SHORT:
                if price >= sig.stop_loss_price:
                    self._close_position(sig, price, "STOP_LOSS")
                elif price <= sig.profit_target_price:
                    self._close_position(sig, price, "PROFIT_TARGET")

    def _close_position(self, sig: TradingSignal,
                        exit_price: float, reason: str):
        side = "sell" if sig.direction == Direction.LONG else "buy"
        self.broker.submit_paper_order(
            symbol=sig.ticker, qty=1,  # use actual shares from order
            side=side, order_type="market"
        )
        self.state_lock[sig.ticker] = False
        log_exit(sig, exit_price, reason)
```

